# ClipForge AI — all local, no API keys needed.
PORT=3000
# Ollama (https://ollama.com) — any small model works: qwen2.5:3b, llama3.2:3b, phi3:mini, gemma2:2b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# whisper.cpp CLI binary name/path and model size: tiny | base | small | medium (auto-downloaded once)
WHISPER_BIN=whisper-cli
WHISPER_MODEL=base
WHISPER_LANG=auto
# Export quality (FFmpeg): lower CRF = higher quality (15-23); preset fast | medium | slow
EXPORT_CRF=17
EXPORT_PRESET=medium
# HyperFrames motion render quality: draft | standard | high
HYPERFRAMES_QUALITY=high
# Default Kokoro voice for voice intros (see the Voice list in the studio): af_heart, bf_emma, am_adam ...
TTS_VOICE=af_heart
# Optional: python with kokoro-onnx installed, if not on PATH
# HYPERFRAMES_PYTHON=C:\path\to\venv\Scripts\python.exe
# Optional: keep projects, models and exports elsewhere (e.g. a bigger drive)
# CLIPFORGE_DATA_DIR=D:\ClipForgeData
# Optional: a separate (stronger) Ollama model for "Edit with AI" in the editor, e.g. qwen3.5:4b or qwen2.5:7b
# OLLAMA_EDIT_MODEL=qwen3.5:4b
# Remotion (editor rendering) is free for individuals and companies of up to 3 people; larger for-profit teams need a Remotion company licence.
